{
  "schemaVersion": "1.0.0",
  "app": {
    "name": "TBC FXL Library Builder",
    "purpose": "Company master code library for mapping collector slang (PointID + Description) into canonical Trimble TBC feature codes. Exports Point Feature Definitions CSV compatible with TBC Convert CSV to FXL."
  },
  "defaults": {
    "export": {
      "fxlPointDefinitionsHeader": [
        "Name",
        "Code",
        "Category",
        "Feature Layer",
        "Label Style",
        "Color",
        "Include in Surface",
        "Attributes (name and type)"
      ],
      "pointDefinitionAttributes": [
        { "name": "RAW_POINTID", "type": "Text" },
        { "name": "RAW_DESC", "type": "Text" },
        { "name": "QA_FLAG", "type": "Text" },
        { "name": "MATCH_REASON", "type": "Text" }
      ]
    },
    "ui": {
      "reviewCode": "REVIEW.UNMAPPED",
      "unknownCodePrefix": "CONTROL.UNKNOWN",
      "confidenceThreshold": 0.85
    },
    "categoryRules": {
      "CONTROL": {
        "featureLayer": "AB_CONTROL",
        "labelStyle": "AB_Control",
        "color": "Magenta",
        "includeInSurface": "No"
      },
      "GRADES": {
        "featureLayer": "AB_GRADES",
        "labelStyle": "AB_Grades",
        "color": "Green",
        "includeInSurface": "Yes"
      },
      "ALIGNMENT": {
        "featureLayer": "AB_ALIGNMENT",
        "labelStyle": "AB_Alignment",
        "color": "Cyan",
        "includeInSurface": "No"
      },
      "PAVEMENT": {
        "featureLayer": "AB_PAVEMENT",
        "labelStyle": "AB_Pavement",
        "color": "Yellow",
        "includeInSurface": "No"
      },
      "DRAINAGE": {
        "featureLayer": "AB_DRAINAGE",
        "labelStyle": "AB_Drainage",
        "color": "Blue",
        "includeInSurface": "No"
      },
      "UTIL": {
        "featureLayer": "AB_UTIL",
        "labelStyle": "AB_Util",
        "color": "Red",
        "includeInSurface": "No"
      },
      "STRUCT": {
        "featureLayer": "AB_STRUCT",
        "labelStyle": "AB_Struct",
        "color": "Orange",
        "includeInSurface": "No"
      },
      "TEMP": {
        "featureLayer": "AB_TEMP",
        "labelStyle": "AB_Temp",
        "color": "Gray",
        "includeInSurface": "No"
      },
      "REVIEW": {
        "featureLayer": "AB_REVIEW",
        "labelStyle": "AB_Review",
        "color": "White",
        "includeInSurface": "No"
      }
    }
  },
  "canonicalCodes": [
    {
      "code": "REVIEW.UNMAPPED",
      "name": "Unmapped / Needs Review",
      "notes": "Fallback code when the tool cannot confidently map a row. Keep this in the Feature Library so TBC can still style/filter review items.",
      "rules": {
        "pointId_exact": [],
        "pointId_prefix": [],
        "pointId_regex": [],
        "desc_exact": [],
        "desc_contains": [],
        "desc_regex": []
      }
    },
    {
      "code": "CONTROL.BENCHMARK",
      "name": "Benchmark",
      "rules": {
        "pointId_exact": ["bm"],
        "pointId_prefix": ["bm", "benchmark", "bench"],
        "pointId_regex": ["^bm\\b.*"],
        "desc_exact": ["benchmark", "bench mark"],
        "desc_contains": ["benchmark", "bench"],
        "desc_regex": []
      }
    },
    {
